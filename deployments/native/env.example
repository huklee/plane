# Copy to $PLANE_RUNTIME/native.env and edit. Read by plane.sh, run-api.sh and build.sh.
# The other templates (api/live/build env, Caddyfile) assume the app is served under /plane
# with uploads at /plane-uploads; change them together if you pick another prefix.
PLANE_PUBLIC_URL=https://plane-host.example.ts.net   # origin users open (no path)
PLANE_SRC=$HOME/plane                                 # this repository
PLANE_RUNTIME=$HOME/plane-runtime                     # binaries, data, logs, secrets (never in git)
