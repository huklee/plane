# $PLANE_RUNTIME/api.env (chmod 600). Generate secrets: openssl rand -hex 32
DEBUG=0
SECRET_KEY=<random>
DATABASE_URL=postgresql://plane:plane@127.0.0.1:55432/plane
REDIS_URL=redis://127.0.0.1:56379/0
# Celery broker on Redis (no RabbitMQ needed)
AMQP_URL=redis://127.0.0.1:56379/1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=plane-minio
AWS_SECRET_ACCESS_KEY=<same as MinIO root password>
AWS_S3_ENDPOINT_URL=http://127.0.0.1:59000
AWS_S3_BUCKET_NAME=plane-uploads
USE_MINIO=1
MINIO_ENDPOINT_SSL=1
FILE_SIZE_LIMIT=5242880
WEB_URL=https://plane-host.example.ts.net
APP_BASE_URL=https://plane-host.example.ts.net/plane/
APP_BASE_PATH=/plane/
ADMIN_BASE_PATH=/plane/god-mode/
SPACE_BASE_PATH=/plane/spaces/
LIVE_BASE_PATH=/plane/live/
LIVE_BASE_URL=https://plane-host.example.ts.net
LIVE_SERVER_SECRET_KEY=<random>
CORS_ALLOWED_ORIGINS=https://plane-host.example.ts.net
ALLOWED_HOSTS=*
GUNICORN_WORKERS=2
API_KEY_RATE_LIMIT=120/minute
DJANGO_SETTINGS_MODULE=plane.settings.production
# Single-user private instance: sign every browser request in as this user (no login screen).
# Anyone who can reach the instance acts as this user; keep it behind a trusted network boundary.
# AUTO_LOGIN_EMAIL=you@example.com
